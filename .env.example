APP_NAME=Samu
DEBUG=true
SECRET_KEY=trocar-em-producao

# MySQL (o sistema cria o banco sozinho na primeira execução):
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/samu?charset=utf8mb4
# Alternativas:
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/samu

REDIS_URL=redis://localhost:6379/0
TIMEZONE=UTC
DEFAULT_LANGUAGE=pt-BR
