# Configuração do ambiente (§35.23). Copie para .env e ajuste.
# O .env nunca é versionado — só este exemplo.

APP_NAME="Qualidade SAMU"
DEBUG=true

# Assina os JWT da API externa (§6) e criptografa as configurações
# sensíveis gravadas no banco (§39.29). Precisa de 32+ bytes: o HS256
# recusa chaves menores. Gere a sua com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar a chave depois invalida os valores já criptografados — quem tiver
# SMTP ou tokens salvos em Configurações precisará cadastrá-los de novo.
SECRET_KEY=gere-uma-chave-de-48-bytes

# MySQL (o sistema cria o banco sozinho na primeira execução):
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/samu?charset=utf8mb4
# Alternativas:
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/samu

# Cache (§26) e fila do Celery (§27). Sem Redis no ar a aplicação continua
# funcionando: o cache cai para memória e as tarefas rodam de forma síncrona.
REDIS_URL=redis://localhost:6379/0

# Onde os arquivos enviados são gravados (§20, §36.12). Caminho relativo é
# resolvido a partir da raiz do projeto, então subir o servidor de outra
# pasta continua apontando para o mesmo lugar.
UPLOAD_DIR=uploads

# Fuso e idioma de fallback. Cada empresa pode sobrescrever o fuso pela
# chave `timezone` em Configurações (§22), que é o que vale nas telas.
TIMEZONE=UTC
DEFAULT_LANGUAGE=pt-BR

# --------------------------------------------------------------------------
# O que NÃO fica aqui
#
# SMTP, push e WhatsApp são configurados por empresa, em Configurações
# dentro do sistema — não por variável de ambiente. As chaves com "pass",
# "senha", "token", "secret" ou "api_key" no nome são criptografadas no
# banco e mascaradas na auditoria (§39.29):
#
#   smtp_host, smtp_port, smtp_user, smtp_pass, smtp_from   e-mail (§39.9)
#   push_url, push_token                                    push (§21)
#   whatsapp_url, whatsapp_token                            WhatsApp (§21)
#
# Push e WhatsApp esperam um endpoint HTTP que receba o payload do
# framework; veja docs/DEPLOY-PYTHONANYWHERE.md e o módulo de notificações.
# --------------------------------------------------------------------------
